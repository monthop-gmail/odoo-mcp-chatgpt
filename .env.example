# คัดลอกเป็น .env แล้วกรอกค่า — .env ถูก gitignore ไว้ อย่า commit

# ---- ท่อของ OpenAI ----
# สร้าง tunnel ที่ Platform settings แล้วเอา id มาใส่
# หนึ่ง tunnel ต่อได้หนึ่ง MCP server เท่านั้น ถ้ามีหลาย server ต้องสร้างหลาย tunnel
CONTROL_PLANE_TUNNEL_ID=
CONTROL_PLANE_API_KEY=
TUNNEL_CLIENT_VERSION=v0.0.12

# ---- MCP server ----
# openssl rand -hex 32
MCP_AUTH_TOKEN=
# พอร์ตนี้มีไว้ทดสอบจากในเครื่องเท่านั้น ท่อคุยผ่าน docker network
MCP_BIND_ADDR=127.0.0.1
MCP_HOST_PORT=8100

# ---- Odoo: หลายเครื่องพร้อมกัน ----
# ต่อได้ทั้ง Community ที่ลงเองและ Enterprise บน Odoo Online ในไฟล์เดียว
# agent เลือกด้วย argument `server` ของแต่ละ tool
ODOO_SERVERS='{"default_server":"ce","servers":{
  "ce":  {"url":"http://host.docker.internal:8069","db":"test19","username":"mcp-bot","password":"..."},
  "ee":  {"url":"https://yourcompany.odoo.com","db":"yourcompany","username":"bot@example.com","password":"api-key"}
}}'

# ---- ทางเลือกสำรอง: เครื่องเดียว (ใช้เมื่อไม่ได้ตั้ง ODOO_SERVERS) ----
# ODOO_URL=
# ODOO_DB=
# ODOO_USERNAME=
# ODOO_PASSWORD=

# ---- รั้วชั้นที่สอง ----
# ห้าม tool แตะ model พวกนี้ ลงท้าย * เพื่อจับแบบขึ้นต้น
BLOCKED_MODELS=ir.*,res.users*,res.groups*
# ALLOWED_MODELS=

LOG_LEVEL=info
LOG_FORMAT=json
